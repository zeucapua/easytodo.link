{
  "lexicon": 1,
  "id": "link.easytodo.tasks.list",
  "defs": {
    "main": {
      "type": "record",
      "description": "A list of items to do.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["id", "title", "createdAt"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "createdAt": { "type": "string", "format": "datetime" },
          "tasks": {
            "type": "array",
            "items": { 
              "type": "ref", 
              "ref": "link.easytodo.tasks.task"
            }
          }
        }
      }
    }
  }
}
